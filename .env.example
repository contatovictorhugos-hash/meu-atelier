# ==============================================================================
# Atelier Environment Variables Template
# ==============================================================================
# DO NOT COMMIT REAL CREDENTIALS OR SECRET KEYS TO VERSION CONTROL.
# Copy this file to .env.local for local development.

# --- Supabase (Free Tier / BaaS) ---
# Public URL and Anonymous Key (Safe for browser client bundle)
NEXT_PUBLIC_SUPABASE_URL=sua_url_aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
# NOTA: NUNCA exponha a Service-Role Key / Chave Mestra no código cliente!

# --- Cloudflare R2 Media Storage (Free Tier - 10GB / Zero Egress Fees) ---
# Public media delivery domain (e.g. your custom domain or R2 dev subdomain)
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://media.atelier.app

# Private R2 Credentials (Server-only Route Handlers - NEVER use NEXT_PUBLIC_ prefix)
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=atelier-media
